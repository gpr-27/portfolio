# One env file for the whole project (frontend + backend). Copy to .env (git-ignored).
# On Render, set the secret values in the dashboard instead.

# Frontend (Vite) — PUBLIC, same-origin API paths:
VITE_CHAT_ENDPOINT=/api/chat
VITE_CONTACT_ENDPOINT=/api/contact

# Backend (server-side only — never bundled):
AGENTROUTER_API_KEY=
MONGODB_URI=
MONGODB_DB=portfolio

# Email notifications (optional, https://resend.com):
RESEND_API_KEY=
CONTACT_TO=praneethg1830@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>
