# Dependencies — reinstalled inside the image via `npm ci`
node_modules

# Build output — regenerated by `npm run build` in the builder stage
dist
dist-ssr

# Secrets — never bake env into the image (provided at runtime via --env-file / env_file)
.env
.env.*
!.env.example

# Version control & CI
.git
.gitignore
.github

# Editor / OS / agent cruft
.DS_Store
.vscode
.idea
.claude

# Logs
*.log
npm-debug.log*

# Large source assets not needed in the image (the built dist/ already has resume.pdf + image)
*.heic
*.pdf

# Docs & deploy configs not needed at build/runtime
README.md
DEPLOY.md
render.yaml
Dockerfile
.dockerignore
docker-compose.yml

# TS incremental build cache
*.tsbuildinfo
